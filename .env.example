# ---------------------------------------------------------------------------
# mont-indirim-bot - ortam degiskenleri
#
# Yerelde test etmek icin bu dosyayi `.env` olarak kopyalayip doldurun.
# GitHub Actions tarafinda bu degerler "Settings > Secrets and variables >
# Actions" altina repo secret'i olarak eklenir (asagidaki REQUIRED olanlar).
# ---------------------------------------------------------------------------

# --- ZORUNLU ---------------------------------------------------------------
# @BotFather'dan alinan bot token'i.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Botun mesaj gonderecegi sohbet. Kendi kullanici id'niz (@userinfobot) ya da
# bir grup/kanal id'si. Bot komutlari SADECE bu id'den kabul edilir.
TELEGRAM_CHAT_ID=123456789

# --- OPSIYONEL -------------------------------------------------------------
# Indirim bildirimi icin minimum dusus yuzdesi (varsayilan: 20).
MIN_DISCOUNT_PCT=20
# Ayni urun icin iki bildirim arasindaki minimum sure, saat (varsayilan: 12).
COOLDOWN_HOURS=12
# Bildirim sonrasi fiyatin "yeniden kurulmasi" icin gereken toparlanma yuzdesi.
REARM_PCT=2
# Istekler arasi rastgele gecikme alt/ust siniri, saniye (varsayilan: 2 / 6).
REQUEST_MIN_DELAY_S=2
REQUEST_MAX_DELAY_S=6
# 403/429 durumunda maksimum deneme sayisi (varsayilan: 3).
MAX_RETRIES=3
# Tek bir HTTP istegi icin zaman asimi, saniye (varsayilan: 20).
REQUEST_TIMEOUT_S=20
# Ayni anda kac urun taransin (varsayilan: 2 - site dostu davranis).
MAX_PARALLEL_REQUESTS=2
# Durum dosyalarinin klasoru (varsayilan: repo kokundeki `data`).
DATA_DIR=data
# DEBUG / INFO / WARNING
LOG_LEVEL=INFO
